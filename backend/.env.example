# Скопируйте этот файл в `.env` и замените значения на свои.
# Файл `.env` не коммитится в Git — см. корневой `.gitignore`.

# PostgreSQL (asyncpg): postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://headache_user:headache_pass@localhost:5432/headache_diary

# Сгенерируйте свой ключ, например: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
