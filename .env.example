# Скопируйте в корень проекта: cp .env.example .env
# Docker Compose автоматически подхватит этот файл.

# PostgreSQL (сервис db)
POSTGRES_USER=headache_user
POSTGRES_PASSWORD=headache_pass
POSTGRES_DB=headache_diary
POSTGRES_PORT=5432

# Backend (порт на хосте)
BACKEND_PORT=8000

# JWT (backend)
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# DATABASE_URL задаётся в docker-compose.yml через hostname сервиса db.
# Для локальной разработки без Docker используйте backend/.env с localhost.
